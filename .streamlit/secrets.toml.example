# Copy to .streamlit/secrets.toml (git-ignored) and fill in real values.
# On Streamlit Community Cloud, paste the same lines into App settings -> Secrets.

# Supabase: Project Settings -> API. Use the server-side SECRET key
# (sb_secret_...) or the legacy service_role key. Never the publishable/anon key.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "sb_secret_REPLACE_ME"

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY = "REPLACE_ME"
GEMINI_MODEL = "gemini-3.5-flash-lite"
